<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GameMenu">

    <TextView
        android:id="@+id/textView"
        android:layout_width="0dp"
        android:layout_height="94dp"
        android:background="#061222"
        android:gravity="center"
        android:text="@string/Menu_Banner"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/guess_the_country_button"
        android:layout_width="180dp"
        android:layout_height="80dp"
        android:backgroundTint="#061222"
        android:text="@string/Guess_The_Country_Button"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/textView"
        app:layout_constraintBottom_toTopOf="@id/guess_hints_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="spread" />

    <Button
        android:id="@+id/guess_hints_button"
        android:layout_width="180dp"
        android:layout_height="80dp"
        android:backgroundTint="#061222"
        android:text="@string/Guess_Hints_Button"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/guess_the_country_button"
        app:layout_constraintBottom_toTopOf="@+id/guess_the_flag_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/guess_the_flag_button"
        android:layout_width="180dp"
        android:layout_height="80dp"
        android:backgroundTint="#061222"
        android:text="@string/Guess_The_Flag_Button"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/guess_hints_button"
        app:layout_constraintBottom_toTopOf="@id/advanced_level_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/advanced_level_button"
        android:layout_width="180dp"
        android:layout_height="80dp"
        android:backgroundTint="#061222"
        android:text="@string/Advanced_Level_Button"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@+id/guess_the_flag_button"
        app:layout_constraintBottom_toTopOf="@id/home_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/home_button"
        android:layout_width="180dp"
        android:layout_height="80dp"
        android:backgroundTint="#061222"
        android:text="@string/Home_Button"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/advanced_level_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>